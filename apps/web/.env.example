# Server-side base URL the Next.js server uses to call the NestJS API
# (SSR fetches, and the auth route handlers that proxy login/register).
API_URL=http://localhost:4000/api

# Client-side base URL for the WebSocket live-scores connection.
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Client-side base URL for direct browser calls (e.g. the team search box).
NEXT_PUBLIC_API_URL=http://localhost:4000/api
