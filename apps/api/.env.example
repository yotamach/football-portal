# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Postgres (see root docker-compose.yml)
DATABASE_URL=postgresql://football:football@localhost:5432/football_portal

# Redis (see root docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# API-Football (RapidAPI) — https://www.api-football.com/
# Sign up on RapidAPI, subscribe to the API-Football API, and paste your key below.
# Leave blank to run the backend in MOCK_MODE with realistic sample data.
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io

# How often (ms) the backend polls API-Football for live fixtures and
# broadcasts diffs over the WebSocket gateway.
LIVE_POLL_INTERVAL_MS=15000
